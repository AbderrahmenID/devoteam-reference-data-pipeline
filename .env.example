# Copy to .env only in an approved private runtime. Never commit .env.
# The pipeline does not load .env automatically; export these values in the
# shell or notebook runtime before executing a data-processing stage.
DEVOTEAM_PROJECT_ROOT="."
DEVOTEAM_PROJECT_FOLDER_ID="replace-with-private-drive-folder-id"
DEVOTEAM_SOURCE_SHORTCUT_ID="replace-with-private-drive-shortcut-id"
DEVOTEAM_ALLOW_EXTERNAL_LLM="false"
DEVOTEAM_LOG_LEVEL="INFO"
